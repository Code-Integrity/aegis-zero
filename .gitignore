# ==============================================================================
# 1. Default Security Perimeter: Deny All (Strict Blacklist)
# ==============================================================================
/*

# ==============================================================================
# 2. Structural Allowances: Directory Whitelist
# ==============================================================================
!/auditors/
!/prompts/
!/config/
!/utils/

# ==============================================================================
# 3. Structural Allowances: Core Files Whitelist
# ==============================================================================
!/README.md
!/run_analysis.py
!/.gitignore
!/LICENSE

# ==============================================================================
# 4. Aegis-Zero: Targeted Security & Privacy Protection Overrides
# ==============================================================================

# ---- Raw DevTools Logs (Absolute Privacy Lockdown) ----
/logs/devtools/
/logs/devtools/**

# Standalone diagnostic data / trace formats
*.har
*.har.json
storage.json
console.json
network.json
sources.json

# ---- Browser Storage State Artifacts ----
*.localstorage
*.sessionstorage
*.cookies
*.webstorage

# ---- Analytical Output Repositories ----
/analysis_output/
/analysis_output/**
/output/
/output/**

# ---- Python Execution Environment Cache ----
__pycache__/
*.pyc

# ---- Python Virtual Environments ----
venv/
.venv/
.env/
.envrc

# ---- Localized AI Model Weight Files (Proprietary / Volumetric Assets) ----
/models/
/models/**
models/**/*.bin
models/**/*.pth
models/**/*.safetensors
models/**/weights/
models/**/checkpoints/

# ---- Local LLM Engine Cache Runtime ----
.llama/
.ollama/
deepseek_cache/
qwen_cache/

# ---- Operating System Artifacts & Junk ----
.DS_Store
Thumbs.db

# ---- VS Code ----
.vscode/
