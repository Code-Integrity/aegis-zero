# ==========================================
# 1. すべてを拒否 (Deny All)
# ==========================================
/*

# ==========================================
# 2. 公開して良いディレクトリの許可
# ==========================================
!/auditors/
!/prompts/
!/config/
!/utils/
!/.vscode/

# ==========================================
# 3. 公開して良いファイルの許可
# ==========================================
!/README.md
!/run_analysis.py
!/.gitignore
!/LICENSE

# ==========================================
# Aegis-Zero: Security & Privacy Protection
# ==========================================

# ---- DevTools logs (絶対に公開してはいけない領域) ----
logs/devtools/
logs/devtools/**

# HAR / JSON / Storage dumps
*.har
*.har.json
storage.json
console.json
network.json
sources.json

# ---- Browser storage exports ----
*.localstorage
*.sessionstorage
*.cookies
*.webstorage

# ---- Temporary analysis outputs ----
analysis_output/
analysis_output/**

# ---- Python cache ----
__pycache__/
*.pyc

# ---- Virtual environments ----
venv/
.env/
.envrc

# ---- Model weights (巨大ファイル・非公開) ----
models/**/*.bin
models/**/*.pth
models/**/*.safetensors
models/**/weights/
models/**/checkpoints/

# ---- LLM runtime cache ----
.llama/
.ollama/
deepseek_cache/
qwen_cache/

# ---- OS / Editor junk ----
.DS_Store
Thumbs.db

# ---- VS Code ----
.vscode/
